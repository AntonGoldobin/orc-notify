# ────────────────────────────────────────────────────────────────
# orc-notify — environment template
# Copy to .env and fill in.
# In CapRover, these are set via the panel UI (or app-linking).
# ────────────────────────────────────────────────────────────────

# Postgres connection string.
# Local dev: postgresql+asyncpg://user:pass@localhost:5432/orc-notify
# CapRover:   postgresql+asyncpg://notifier:<pg_password>@srv-captain--orc-notify-postgres:5432/notifier
DATABASE_URL=postgresql+asyncpg://notifier:notifier@localhost:5432/orc-notify

# JWT signing secret. Use `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALG=HS256
JWT_TTL_MINUTES=43200

# Cookie attributes
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_NAME=notifier_session

# Public base URL — used to build password reset links.
# CapRover: https://orc-notify.orc.golden-antelope.ru
PUBLIC_BASE_URL=http://localhost:8000

# App metadata
APP_NAME=orc-notify
LOG_LEVEL=INFO
